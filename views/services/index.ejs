                                    <hr class="my-2 opacity-25">

                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        <div>
                                            <span class="fs-5 fw-bold text-dark">
                                                ₹<%= service.charges ? service.charges.toLocaleString('en-IN') : 0 %>
                                            </span>
                                        </div>
                                        
                                        <div class="form-check">
                                            <input class="form-check-input provider-checkbox" 
                                                   type="checkbox" 
                                                   name="selectedServices[]" 
                                                   value="<%= service._id %>" 
                                                   data-price="<%= service.charges || 0 %>"
                                                   data-has-input1="false"
                                                   data-has-input2="false">
                                        </div>
                                    </div>

                                    <div class="mt-2 text-muted small">
                                        <i class="fas fa-map-marker-alt me-1"></i> <%= service.address || "Location not available" %>
                                    </div>

                                    <div class="mt-2 text-muted small">
                                        <i class="fas fa-phone me-1"></i> <%= service.phoneNumber || "N/A" %>
                                    </div>

                                    <% if(service.keyFeatures && service.keyFeatures.length > 0) { %>
                                        <div class="mt-3">
                                            <% service.keyFeatures.forEach(f => { %>
                                                <span class="badge bg-light text-dark border me-1"><%= f %></span>
