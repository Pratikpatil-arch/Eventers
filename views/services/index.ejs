                    <% servicesInCat.forEach(service => { %>

                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 shadow-sm provider-card position-relative" onclick="toggleSelection(this)">
                                <div class="card-body">
                                    
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h5 class="fw-bold mb-1 text-truncate"><%= service.type %></h5>
                                    </div>
                                    
                                    <div class="text-success small mb-3">
                                        <i class="fas fa-check-circle me-1"></i> Verified Service
