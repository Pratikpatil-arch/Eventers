</div>

<script>
    const draggable = document.getElementById("draggableCalculator");
    const header = document.getElementById("dragHeader");
    let isDragging = false, offsetX, offsetY;

    header.addEventListener("mousedown", (e) => {
        isDragging = true;
        offsetX = e.clientX - draggable.getBoundingClientRect().left;
        offsetY = e.clientY - draggable.getBoundingClientRect().top;
    });

    document.addEventListener("mousemove", (e) => {
        if (!isDragging) return;
        draggable.style.left = `${e.clientX - offsetX}px`;
        draggable.style.top = `${e.clientY - offsetY}px`;
        draggable.style.bottom = "auto";
        draggable.style.right = "auto";
    });

    document.addEventListener("mouseup", () => {
        isDragging = false;
    });

    function toggleSelection(card) {
        const checkbox = card.querySelector('.provider-checkbox');
        const border = card.querySelector('.selection-border');

        checkbox.checked = !checkbox.checked;

        if(checkbox.checked) {
            border.classList.remove('d-none');
            card.classList.add('bg-light');
        } else {
            border.classList.add('d-none');
            card.classList.remove('bg-light');
        }

        updateCalculator();
    }

    // 3. ADVANCED CALCULATOR LOGIC
    function updateCalculator() {
        let total = 0;
        let count = 0;
        const checkboxes = document.querySelectorAll('.provider-checkbox');
        checkboxes.forEach(box => {
            if(box.checked) {
                const basePrice = parseInt(box.getAttribute('data-price'));
                const hasInput1 = box.getAttribute('data-has-input1') === 'true';
                const hasInput2 = box.getAttribute('data-has-input2') === 'true'; 
                let multiplier1 = 1;
                let multiplier2 = 1;
                const card = box.closest('.provider-card');
                if(hasInput1) { const input1 = card.querySelector('.qty-input-1'); if(input1 && input1.value) { multiplier1 = parseInt(input1.value); if(multiplier1 < 1) multiplier1 = 1; } }
                if(hasInput2) { const input2 = card.querySelector('.qty-input-2'); if(input2 && input2.value) { multiplier2 = parseInt(input2.value); if(multiplier2 < 1) multiplier2 = 1; } }
                total += (basePrice * multiplier1 * multiplier2);
                count++;
            }
        });
        document.getElementById('totalCostDisplay').innerText = "₹" + total.toLocaleString('en-IN');
        document.getElementById('countDisplay').innerText = count;
        const btn = document.getElementById('bookBtn');
        if(count > 0) btn.classList.remove('disabled'); else btn.classList.add('disabled');
    }
</script>

