<style>
    @media (max-width: 767.98px) {
    .container.py-5 {
        padding-top: 1.25rem !important;
        padding-bottom: 1.25rem !important;
        padding-left: 0.85rem;
        padding-right: 0.85rem;
    }

    .row.g-4.align-items-stretch {
        --bs-gutter-y: 1rem;
    }

    /* ===== Service Info Card — back to normal, just mobile-friendly ===== */
    .card.shadow-lg.border-0.overflow-hidden {
        border-radius: 12px !important;
    }

    .card-header.show-color.text-white.text-center.py-4 {
        padding: 1.25rem 1rem !important;
    }

    .card-header.show-color h2.fw-bold {
        font-size: 1.25rem;
    }

    .card-header.show-color p.opacity-75 {
        font-size: 0.8rem;
    }

    .card-body.p-4.text-center {
        padding: 1rem !important;
    }

    .card-body h1.display-5 {
        font-size: 1.8rem;
        margin-bottom: 0.75rem !important;
    }

    .card-body hr {
        margin: 0.75rem 0;
    }

    .list-group-item {
        font-size: 0.85rem;
        padding: 0.6rem 0.85rem;
    }

    .card-body h5.fw-bold {
        font-size: 0.95rem;
    }

    .card-body .badge {
        font-size: 0.7rem;
        padding: 0.3rem 0.55rem;
        margin-bottom: 0.3rem;
    }

    /* ===== Review Form — minimized ===== */
    .comment-box .card-body {
        padding: 0.75rem !important;
    }

    .comment-box h4 {
        font-size: 0.9rem;
        margin-bottom: 0.4rem;
    }

    .comment-box .form-label {
        font-size: 0.75rem;
        margin-bottom: 0.2rem;
    }

    .comment-box .mb-3.mt-3 {
        margin-top: 0.4rem !important;
        margin-bottom: 0.4rem !important;
    }

    .starability-slot {
        width: 110px;
        min-height: 22px;
        transform: scale(0.75);
        transform-origin: left center;
    }

    .comment-box textarea.form-control {
        font-size: 0.78rem;
        padding: 0.4rem;
    }

    .comment-box textarea#comment {
        min-height: 70px;
    }

    .comment-box .btn.btn-outline-dark {
        width: 100%;
        padding: 0.45rem;
        font-size: 0.8rem;
        margin-top: 0.4rem;
    }

    hr.my-5 {
        margin-top: 1.5rem !important;
        margin-bottom: 1.5rem !important;
    }

    /* ===== All Reviews — 2 per row ===== */
    h3.fw-bold.mb-4 {
        font-size: 1.1rem;
        margin-bottom: 0.85rem !important;
    }

    .col-12 > .row.g-4 {
        --bs-gutter-x: 0.5rem;
        --bs-gutter-y: 0.5rem;
    }

    .col-12 > .row.g-4 > .col-md-6.col-lg-4 {
        flex: 0 0 auto;
        width: 50% !important;
        max-width: 50% !important;
    }

    .col-12 > .row.g-4 .card.h-100.shadow-sm {
        border-radius: 10px;
        border-left: 3px solid #39B1D1 !important;
    }

    .col-12 > .row.g-4 .card-body {
        padding: 0.65rem;
    }

    .col-12 > .row.g-4 .card-title {
        font-size: 0.75rem;
        margin-bottom: 0.3rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .col-12 > .row.g-4 .starability-result {
        transform: scale(0.7);
        transform-origin: left center;
        margin-bottom: 0.2rem;
    }

    .col-12 > .row.g-4 .card-text {
        font-size: 0.68rem;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .col-12 > .row.g-4 .btn.btn-dark.btn-sm {
        font-size: 0.65rem;
        padding: 0.25rem 0.5rem;
        margin-top: 0.4rem;
    }
}

/* Extra small phones */
@media (max-width: 375px) {
    .card-body h1.display-5 {
        font-size: 1.55rem;
    }

    .card-header.show-color h2.fw-bold {
        font-size: 1.1rem;
    }

    .list-group-item {
        font-size: 0.8rem;
    }

    .comment-box h4 {
        font-size: 0.85rem;
    }

    .starability-slot {
        transform: scale(0.65);
    }

    .col-12 > .row.g-4 .card-title {
        font-size: 0.68rem;
    }

    .col-12 > .row.g-4 .card-text {
        font-size: 0.62rem;
    }
}
@media (max-width: 767.98px) {
    /* Space between reviews and footer */
    .container.py-5 {
        padding-bottom: 3rem !important;
    }

    /* Review form — keep full width, just reduce height */
    .comment-box .card-body {
        padding: 0.75rem !important;
    }

    .comment-box h4 {
        font-size: 0.9rem;
        margin-bottom: 0.3rem;
    }

    .comment-box .form-label {
        font-size: 0.75rem;
        margin-bottom: 0.15rem;
    }

    .comment-box .mb-3.mt-3 {
        margin-top: 0.3rem !important;
        margin-bottom: 0.3rem !important;
    }

    /* Stars — keep in one row, don't shrink width of the form itself */
    .starability-slot {
        width: 100%;
        max-width: 220px;
        min-height: 24px;
        display: flex;
        white-space: nowrap;
    }

    .starability-slot > label {
        float: none;
        flex-shrink: 0;
    }

    .comment-box textarea.form-control {
        font-size: 0.78rem;
        padding: 0.4rem;
    }

    .comment-box textarea#comment {
        min-height: 60px;
    }

    .comment-box .btn.btn-outline-dark {
        width: 100%;
        padding: 0.4rem;
        font-size: 0.8rem;
        margin-top: 0.35rem;
    }
}
@media (max-width: 767.98px) {
    .container.py-5 {
        padding-bottom: 6rem !important;
    }
}
</style>
<% layout('layouts/boilerplate') %>
<div class="container py-5">


<!-- <div class="row justify-content-center mb-5">
    <div class="col-md-8"> -->
       <div class="row g-4 align-items-stretch">

    <!-- LEFT : Service Information -->
    <div class="col-lg-6">
        <div class="card shadow-lg border-0 overflow-hidden">

            <!-- Header -->
            <div class="card-header show-color text-white text-center py-4">
                <h2 class="fw-bold mb-0"><%= service.serviceName %></h2>
                <p class="mb-0 opacity-75"><%= service.type %></p>
            </div>

            <!-- Body -->
            <div class="card-body p-4 text-center">

                <!-- Price -->
                <h1 class="fw-bold display-5 text-success mb-3">
                    ₹<%= service.charges ? service.charges.toLocaleString('en-IN') : 0 %>
                </h1>

                <hr>

                <!-- Details -->
                <ul class="list-group list-group-flush text-start mb-3">

                     <li class="list-group-item">
                    <i class="fas fa-user-circle me-2 text-primary"></i>
                        <%= service.owner.username || "No username provided" %>
                    </li>

                    <li class="list-group-item">
                        <i class="fas fa-map-marker-alt me-2 text-primary"></i> 
                        <%= service.address || "No address provided" %>
                    </li>

                    <li class="list-group-item">
                        <i class="fas fa-phone me-2 text-primary"></i> 
                        <%= service.phoneNumber || "N/A" %>
                    </li>

                </ul>

                <!-- Features -->
                <% if(service.keyFeatures && service.keyFeatures.length > 0) { %>
                    <div class="mt-3">
                        <h5 class="fw-bold mb-2">Key Features</h5>
                        <% service.keyFeatures.forEach(f => { %>
                            <span class="badge bg-light text-dark border me-1"><%= f %></span>
                        <% }) %>
                    </div>
                <% } %>

            </div>
        </div>
    </div>

<!-- <div class="col-8 offset-2"> -->
    <div class="col-lg-6">
   

         <div class="card comment-box shadow-lg border-0 h-100">
        <div class="card-body">

<h4>Leave a Review</h4>

    <form action="/events/<%= encodeURIComponent(eventName) %>/services/<%= service._id %>/reviews" 
          method="POST" 
          class="mb-3 needs-validation" 
          novalidate>

        <!-- Star Rating -->
        <div class="mb-3 mt-3">
            <label for="rating" class="form-label">Rating</label>

            <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked />

                <input type="radio" id="rate1" name="review[rating]" value="1" />
                <label for="rate1" title="Terrible">1 star</label>

                <input type="radio" id="rate2" name="review[rating]" value="2" />
                <label for="rate2" title="Not good">2 stars</label>

                <input type="radio" id="rate3" name="review[rating]" value="3" />
                <label for="rate3" title="Average">3 stars</label>

                <input type="radio" id="rate4" name="review[rating]" value="4" />
                <label for="rate4" title="Very good">4 stars</label>

                <input type="radio" id="rate5" name="review[rating]" value="5" />
                <label for="rate5" title="Amazing">5 stars</label>
            </fieldset>
        </div>

        <!-- Comment -->
        <div class="mb-3 mt-3">
            <label for="comment" class="form-label">Comments</label>
            <textarea name="review[comment]" 
                      class="form-control" 
                      id="comment" 
                      rows="5" 
                      required></textarea>
            <div class="invalid-feedback">
                Please add some comments for review
            </div>
        </div>

        <button class="btn btn-outline-dark">Submit</button>
        
    </div>
    </div>
       
    </div>
</div>   <!-- closes row -->
<hr class="my-5">

    <!-- <p><b>All Reviews</b></p>

    <div class="row"> -->

<div class="row">
    <div class="col-12">
        <h3 class="fw-bold mb-4">
            <i class="fa-regular fa-comment"></i>
            All Reviews
        </h3>
    </div>

    <div class="col-12">
        <div class="row g-4">
        <% if(service.reviews.length === 0) { %>
            <p class="text-muted">No reviews yet.</p>
        <% } %>

        <% service.reviews.forEach(review => { %>
            <div class="col-md-6 col-lg-4">
              <div class="card h-100 shadow-sm">
                <div class="card-body">

                    <!-- If no author field, keep static -->
                    <h5 class="card-title">@<%=review.author.username %></h5>

                    <!-- Star display -->
                    <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>

                    <p class="card-text">
                        <%= review.comment %>
                    </p>

                    <% if(currUser && review.author._id.equals(currUser._id)){%>
                    <!-- Delete -->
                    <form action="/events/<%= encodeURIComponent(eventName) %>/services/<%= service._id %>/reviews/<%= review._id %>?_method=DELETE"
                          method="POST">
                        <button class="btn btn-dark btn-sm">Delete</button>
                    </form>
                     <%}%>
                </div>
            </div>
                </div>
        <% }) %>
    </div>
        </div>

</div>
</div>

<!-- review thing here -->
