<div class="col-8 offset-2">
    <% if(currUser){%>
    <h4>Leave a Review</h4>

    <form action="/events/<%= encodeURIComponent(eventName) %>/services/<%= service._id %>/reviews" 
          method="POST" 
          class="mb-3 needs-validation" 
          novalidate>

        <!-- Star Rating -->
        <div class="mb-3 mt-3">
            <label for="rating" class="form-label">Rating</label>

            <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked />

                <input type="radio" id="rate1" name="review[rating]" value="1" />
                <label for="rate1" title="Terrible">1 star</label>

                <input type="radio" id="rate2" name="review[rating]" value="2" />
                <label for="rate2" title="Not good">2 stars</label>

                <input type="radio" id="rate3" name="review[rating]" value="3" />
                <label for="rate3" title="Average">3 stars</label>

                <input type="radio" id="rate4" name="review[rating]" value="4" />
                <label for="rate4" title="Very good">4 stars</label>

                <input type="radio" id="rate5" name="review[rating]" value="5" />
                <label for="rate5" title="Amazing">5 stars</label>
            </fieldset>
        </div>

        <!-- Comment -->
        <div class="mb-3 mt-3">
            <label for="comment" class="form-label">Comments</label>
            <textarea name="review[comment]" 
                      class="form-control" 
                      id="comment" 
                      rows="5" 
                      required></textarea>
            <div class="invalid-feedback">
                Please add some comments for review
            </div>
        </div>

        <button class="btn btn-outline-dark">Submit</button>
         <%}%>
    </form>

    <hr>

    <p><b>All Reviews</b></p>

    <div class="row">
        <% if(service.reviews.length === 0) { %>
            <p class="text-muted">No reviews yet.</p>
        <% } %>

        <% service.reviews.forEach(review => { %>
            <div class="card col-5 mb-3 mx-2">
                <div class="card-body">

                    <!-- If no author field, keep static -->
                    <h5 class="card-title">@<%=review.author.username %></h5>

                    <!-- Star display -->
                    <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>

                    <p class="card-text">
                        <%= review.comment %>
                    </p>

                    <% if(currUser && review.author._id.equals(currUser._id)){%>
                    <!-- Delete -->
                    <form action="/events/<%= encodeURIComponent(eventName) %>/services/<%= service._id %>/reviews/<%= review._id %>?_method=DELETE"
                          method="POST">
                        <button class="btn btn-dark btn-sm">Delete</button>
                    </form>
                     <%}%>
                </div>
            </div>
        <% }) %>
    </div>
</div>

</div>

