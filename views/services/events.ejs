<style>
     @media (max-width: 767.98px) {
    /* Header */
    .container.my-5.text-center h1.display-4 {
        font-size: 1.8rem;
    }

    .container.my-5.text-center p.lead {
        font-size: 0.9rem;
        padding: 0 0.5rem;
    }

    .container.my-5.text-center hr.w-25 {
        margin-bottom: 2rem !important;
    }

    /* Keep 1 card per row, just tighten gutter */
    .row.row-cols-1.row-cols-md-2.row-cols-lg-3 {
        --bs-gutter-y: 1.25rem;
    }

    /* Card image */
    .event-card .event-img {
        height: 200px;
    }

    /* Card body */
    .event-card .card-body.p-4 {
        padding: 1.25rem !important;
    }

    .event-card .card-title {
        font-size: 1.05rem;
    }

    .event-card .card-text {
        font-size: 0.85rem;
    }

    .event-card {
        border-radius: 12px;
    }

    .event-card:hover {
        transform: translateY(-4px);
    }
}

/* Extra small phones */
@media (max-width: 375px) {
    .event-card .event-img {
        height: 180px;
    }

    .container.my-5.text-center h1.display-4 {
        font-size: 1.5rem;
    }
}






</style>





<% layout('layouts/boilerplate') %>


<div class="container my-5 text-center">
    <h1 class="display-4 fw-bold">Explore Our Events</h1>
    <p class="lead text-muted">From intimate gatherings to grand celebrations, we make every moment unforgettable.</p>
    <hr class="w-25 mx-auto mb-5">
</div>

<div class="container mb-5">
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        
        <% for (let event of events) { %>
            <div class="col">
                <div class="card h-100 shadow-sm border-0 event-card">
                    
                    <a href="/events/<%= event.name %>/services" class="overflow-hidden position-relative">
                        <img src="<%= event.image %>" class="card-img-top event-img" alt="<%= event.name %>">
                        <div class="card-img-overlay">
                            <span class="text-white fw-bold"></span>
                        </div>
                    </a>

                    <div class="card-body text-center p-4 d-flex flex-column">
                        <h5 class="card-title fw-bold text-uppercase mb-3 letter-spacing-1">
                            <%= event.name %>
                        </h5>
                        
                        <p class="card-text text-muted small mb-4 flex-grow-1">
                            <%= event.description.substring(0, 100) %>...
                        </p>
                        
                       
                    </div>
                </div>
            </div>
        <% } %>

    </div>
</div>
