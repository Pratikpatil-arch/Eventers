<style>
    @media (max-width: 767.98px) {
    .container.my-5 {
        margin-top: 2rem !important;
        margin-bottom: 6rem !important;
        padding-left: 0.75rem;
        padding-right: 0.75rem;
    }

    .card.shadow-lg.border-0 {
        border-radius: 10px !important;
    }

    .card-header.bg-warning.text-dark,
    .card-header.bg-success.text-white {
        padding: 0.6rem 0.85rem;
    }

    .card-header.bg-warning.text-dark h3.fw-bold,
    .card-header.bg-success.text-white h3.fw-bold {
        font-size: 1rem;
    }

    .card-body.p-4 {
        padding: 0.85rem !important;
        padding-bottom: 1.5rem !important;
    }

    .form-label.fw-bold {
        font-size: 0.75rem;
        margin-bottom: 0.25rem;
    }

    .form-select,
    .form-control {
        font-size: 0.8rem;
        padding: 0.4rem 0.6rem;
        height: auto;
    }

    .form-control::placeholder {
        font-size: 0.75rem;
    }

    small.text-muted {
        font-size: 0.65rem;
    }

    .mb-3 {
        margin-bottom: 0.6rem !important;
    }

    /* Buttons — single line, opposite ends */
    .d-flex.justify-content-between.align-items-center.mt-4 {
        justify-content: space-between !important;
        margin-top: 1rem !important;
        margin-bottom: 0.5rem;
    }

    .d-flex.justify-content-between.align-items-center.mt-4 .btn {
        padding: 0.45rem 1rem;
        font-size: 0.8rem;
        white-space: nowrap;
    }
}

/* Extra small phones */
@media (max-width: 375px) {
    .card-body.p-4 {
        padding: 0.7rem !important;
        padding-bottom: 1.25rem !important;
    }

    .card-header.bg-warning.text-dark h3.fw-bold,
    .card-header.bg-success.text-white h3.fw-bold {
        font-size: 0.9rem;
    }

    .form-select,
    .form-control {
        font-size: 0.75rem;
        padding: 0.35rem 0.5rem;
    }

    .form-label.fw-bold {
        font-size: 0.7rem;
    }

    .d-flex.justify-content-between.align-items-center.mt-4 .btn {
        font-size: 0.75rem;
        padding: 0.4rem 0.85rem;
    }
}
</style>

<% layout('layouts/boilerplate') %>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-success text-white">
                    <h3 class="fw-bold mb-0">Add New Service</h3>
                </div>


            <div class="card-body p-4">
                
                <form action="/events/<%= eventName.name %>/services" method="POST" class="needs-validation" novalidate>
                    
                    <!-- Service Type -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Service Category</label>
                        <select class="form-select" name="service[type]" required>
                            <option value="" disabled selected>Select Category...</option>
                            <option value="Catering">Catering</option>
                            <option value="Photography">Photography</option>
                            <option value="Decoration">Decoration</option>
                            <option value="Venue">Venue (Hotel/Hall)</option>
                            <option value="Music/DJ">Music/DJ</option>
                            <option value="Transport">Transport</option>
                        </select>
                    </div>

                   <div class="mb-3">
                        <label class="form-label fw-bold">Service Name</label>
                        <input type="text" 
                               class="form-control" 
                               name="service[serviceName]" 
                               placeholder="Enter service name" 
                               required>
                                  <div class="valid-feedback">Service name looks Good</div>
                    </div>

                    <!-- Phone -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Contact Phone</label>
                        <input type="text" 
                               class="form-control" 
                               name="service[phoneNumber]" 
                               placeholder="+91 9876543210" 
                               required>
                                  <div class="valid-feedback">Phone number Looks Good</div>
                    </div>

                    <!-- Address -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Address</label>
                        <input type="text" 
                               class="form-control" 
                               name="service[address]" 
                               placeholder="Enter service location" 
                               required>
                                  <div class="valid-feedback">Address looks Good</div>
                    </div>

                    <!-- Charges -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Charges (₹)</label>
                        <input type="number" 
                               class="form-control" 
                               name="service[charges]" 
                               min="0" 
                               required>
                                  <div class="valid-feedback">Charges are fine</div>
                    </div>

                    <!-- Key Features -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Key Features (Comma separated)</label>
                        <input type="text" 
                               class="form-control" 
                               name="service[keyFeatures]" 
                               placeholder="AC, Wifi, Veg Only">
                        <small class="text-muted">Enter features separated by commas.</small>
                    </div>

                    <!-- Buttons -->
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <button class="btn btn-success px-4">Submit Service</button>
                        <a href="/events/<%= eventName.name %>/services" class="btn btn-secondary">Cancel</a>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>


</div>
