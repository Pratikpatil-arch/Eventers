<style>
    /* Mobile improvements for login card */
@media (max-width: 767.98px) {
    .container-fluid.min-vh-100 {
        align-items: flex-start !important;
        padding-top: 5rem;
        padding-bottom :0px !important;
    }

    .card.shadow.border-0 {
        border-radius: 16px !important;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08) !important;
    }

    .card-body.p-4.p-sm-5 {
        padding: 1.75rem 1.5rem !important;
    }

    .card-body h2.fw-bold {
        font-size: 1.5rem;
    }

    .card-body p.text-muted.small {
        font-size: 0.85rem;
    }

    .form-label.small {
        font-size: 0.8rem;
        margin-bottom: 0.35rem;
    }

    .form-control {
        padding: 0.6rem 0.75rem;
        font-size: 0.95rem;
    }

    .btn.btn-success.w-100 {
        margin-top: 0.5rem;
        padding: 0.65rem !important;
        font-size: 0.95rem;
    }
}

/* Extra small phones (iPhone SE, small Android) */
@media (max-width: 375px) {
    .container-fluid.min-vh-100 {
        padding-top: 3.5rem;
        padding-left: 0.75rem;
        padding-right: 0.75rem;
    }

    .card-body.p-4.p-sm-5 {
        padding: 1.5rem 1.25rem !important;
    }
}
</style>

<%- layout("/layouts/boilerplate")%>

    <body>
        <div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center mb-2 pb-5" style="background-color:white">
    <div class="card shadow border-0 overflow-hidden w-100" style="max-width: 950px; border-radius: 12px;">
        <div class="row g-0">
            
            <div class="col-md-6 d-none d-md-block position-relative">
                <img src="https://images.pexels.com/photos/3172572/pexels-photo-3172572.jpeg" 
                     alt="Events celebration" 
                     class="w-100 h-100" 
                     style="object-fit: cover; min-height: 450px;">
                <div class="position-absolute bottom-0 start-0 p-4 text-white w-100" style="background: linear-gradient(transparent, rgba(0,0,0,0.7));">
                    <h4 class="fw-bold mb-1">Make It Memorable</h4>
                    <p class="small mb-0 opacity-75">Manage your service bookings effortlessly.</p>
                </div>
            </div>

            <div class="col-12 col-md-6 d-flex align-items-center bg-white">
                <div class="card-body p-4 p-sm-5">
                    
                    <div class="text-center text-md-start mb-4">
                        <h2 class="fw-bold text-dark mb-1">Welcome Back</h2>
                        <p class="text-muted small">Login to your Eventers account</p>
                    </div>



                <form action="/login" method="POST" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label for="username" class="form-label small fw-semibold text-secondary">Username</label>
                        <div class="input-group">
                        <input type="text" name="username" id="username" class="form-control" required>
                        <div class="invalid-feedback">Please enter your username.</div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="password" class="form-label small fw-semibold text-secondary">password</label>
                        <input type="password" name="password" id="password" class="form-control" required>
                        <div class="invalid-feedback">Please enter your password.</div>
                    </div>
                    <button class="btn btn-success w-100 py-2 fw-semibold" style="letter-spacing: 0.5px;">LogIn</button>
                </form>
            </div>
            </div>
       </div>
       </div>
</div>
    </body>