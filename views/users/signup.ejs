<style>
  @media (max-width: 767.98px) {
    .container-fluid.d-flex.align-items-center.justify-content-center {
        align-items: flex-start !important;
        padding-top: 2.5rem;
    }
}
</style>



<%- layout("/layouts/boilerplate")%>

<body>
  <div class="container-fluid d-flex align-items-center justify-content-center mb-5 pb-5"
       style="background-color:white; min-height: 100vh;">
    <div class="card shadow-sm border-0 overflow-hidden w-100"
         style="max-width: 900px; border-radius: 12px;">
      <div class="row g-0">

        <!-- Image -->
        <div class="col-md-5 d-none d-md-block p-0">
          <img src="https://images.pexels.com/photos/36606989/pexels-photo-36606989.jpeg"
               alt="Eventers" class="w-100 h-100"
               style="object-fit: cover; min-height:100%;">
        </div>

        <!-- Form -->
        <div class="col-md-7">
          <div class="p-3 p-md-4">
            <h3 class="fw-bold mb-1">Create your account</h3>
            <p class="text-muted small mb-3">Join Eventers in a minute.</p>

             <form action="/signup" method="POST" class="needs-validation" novalidate>

                    <!-- Username -->
                    <div class="mb-2">
                        <label for="username" class="form-label small fw-semibold text-secondary">Username</label>
                        <input type="text" name="username" id="username" class="form-control" required>
                        <div class="valid-feedback">Looks good!</div>
                    </div>

                    <!-- Email -->
                    <div class="mb-2">
                        <label for="email" class="form-label small fw-semibold text-secondary">Email</label>
                        <input type="email" name="email" id="email" class="form-control" required>
                        <div class="valid-feedback">Decent Email!</div>
                    </div>

                    <div class="mb-2">
                        <label for="phoneNumber" class="form-label small fw-semibold text-secondary">Phone Number</label>
                        <input type="text" name="phoneNumber" id="phoneNumber" class="form-control" required>
                        <div class="valid-feedback">Decent Phone Number</div>
                    </div>

                    <!-- Password -->
                    <div class="mb-2">
                        <label for="password" class="form-label small fw-semibold text-secondary">Password</label>
                        <input type="password" name="password" id="password" class="form-control" required>
                    </div>

                    <!-- Role selection -->
                    <div class="mb-3">
                        <label for="role" class="form-label small fw-semibold text-secondary">Register as</label>
                        <select name="role" id="role" class="form-select">
                            <option value="client" selected>Client</option>
                            <option value="provider">Service Provider</option>
                        </select>
                    </div>

                    <button class="btn btn-success">Sign Up</button>
                </form>
          </div>
        </div>

      </div>
    </div>
  </div>
</body>
