<%- layout("/layouts/boilerplate") %>

<div class="container my-5">

  <!-- Header -->
  <div class="text-center mb-5">
    <h1 class="fw-bold">Our Network</h1>
    <p class="text-muted">Explore our trusted service providers</p>
  </div>

  <!-- Shuffle services -->
  <% const shuffled = services.sort(() => 0.5 - Math.random()); %>

  <div class="row g-4">

    <% shuffled.forEach(service => { %>

      <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm service-card">

          <div class="card-body">

            <!-- Category badge -->
            <span class="badge bg-primary mb-2">
              <%= service.type %>
            </span>

            <!-- Title -->
            <h5 class="fw-bold mb-2">
              <%= service.serviceName %>
            </h5>

            <!-- Location -->
            <p class="text-muted mb-2">
              <i class="fas fa-map-marker-alt me-2"></i>
              <%= service.address || "Location not available" %>
            </p>

            <!-- Price -->
            <p class="mb-2">
              <strong>Charges:</strong> ₹<%= service.charges %>
            </p>

            <!-- Phone -->
            <p class="mb-3">
              <strong>Phone:</strong> <%= service.phoneNumber %>
            </p>

            <hr>

            <!-- Owner Info -->
            <% if (service.owner) { %>
              <p class="mb-1">
                <strong>Provider:</strong> <%= service.owner.username %>
              </p>

              <p class="mb-3">
                <a href="mailto:<%= service.owner.email %>" class="text-decoration-none">
                  <i class="fas fa-envelope me-1"></i>
                  <%= service.owner.email %>
                </a>
              </p>
            <% } %>

            <!-- Action Button -->

          </div>

        </div>
      </div>

    <% }) %>

  </div>

</div>

<!-- Extra Styling -->
<style>
  .service-card {
    transition: all 0.3s ease;
    border-radius: 12px;
  }

  .service-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.15);
  }

  .badge {
    font-size: 0.75rem;
    letter-spacing: 0.5px;
  }
</style>