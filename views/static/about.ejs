<style>
    @media (max-width: 767.98px) {
    .container.my-5 {
        margin-top: 2rem !important;
        margin-bottom: 2rem !important;
        padding-left: 1.25rem;
        padding-right: 1.25rem;
    }

    /* Header */
    .text-center.mb-5 h1.display-4 {
        font-size: 1.9rem;
    }

    .text-center.mb-5 p.lead {
        font-size: 0.95rem;
    }

    .text-center.mb-5 {
        margin-bottom: 2rem !important;
    }

    /* Who We Are */
    .row.align-items-center.mb-5 {
        margin-bottom: 2rem !important;
    }

    .row.align-items-center.mb-5 h3.fw-bold {
        font-size: 1.3rem;
        margin-bottom: 0.75rem !important;
    }

    .row.align-items-center.mb-5 p.text-muted {
        font-size: 0.9rem;
    }

    .row.align-items-center.mb-5 .col-md-6:last-child {
        margin-top: 1.25rem;
    }

    .row.align-items-center.mb-5 img.img-fluid {
        border-radius: 10px;
    }

    /* Mission & Vision, What We Offer, How It Works cards */
    .p-4.shadow-sm.rounded.h-100 {
        padding: 1.25rem !important;
        margin-bottom: 1rem;
    }

    .p-4.shadow-sm.rounded.h-100 h4.fw-bold,
    .p-4.shadow-sm.rounded.h-100 h5.fw-bold {
        font-size: 1.05rem;
        margin-bottom: 0.5rem;
    }

    .p-4.shadow-sm.rounded.h-100 p.text-muted {
        font-size: 0.85rem;
        margin-bottom: 0;
    }

    /* Section headers ("What We Offer", "How It Works") */
    h3.fw-bold.mb-4,
    h3.fw-bold.text-center.mb-4 {
        font-size: 1.3rem;
        margin-bottom: 1.25rem !important;
    }

    /* How It Works — tighten spacing between stacked steps */
    .mb-5 .row.text-center .col-md-4 {
        margin-bottom: 1.25rem;
    }

    .mb-5 .row.text-center .col-md-4:last-child {
        margin-bottom: 0;
    }

    .mb-5 .row.text-center h5.fw-bold {
        font-size: 1rem;
    }

    .mb-5 .row.text-center p.text-muted {
        font-size: 0.85rem;
    }

    /* Stats — 2x2 grid instead of stacking 4 full-width rows */
    .row.text-center.mb-5 .col-md-3 {
        width: 50% !important;
        flex: 0 0 50% !important;
        margin-bottom: 1.25rem;
    }

    .row.text-center.mb-5 .col-md-3 h2.fw-bold {
        font-size: 1.6rem;
        margin-bottom: 0.15rem;
    }

    .row.text-center.mb-5 .col-md-3 p.text-muted {
        font-size: 0.8rem;
    }

    /* Call to Action */
    .bg-dark.text-white.p-5.rounded {
        padding: 2rem 1.5rem !important;
    }

    .bg-dark.text-white.p-5.rounded h3.fw-bold {
        font-size: 1.25rem;
    }

    .bg-dark.text-white.p-5.rounded p.mb-4 {
        font-size: 0.9rem;
        margin-bottom: 1.25rem !important;
    }

    .bg-dark.text-white.p-5.rounded .btn.btn-lg {
        padding: 0.6rem 1.5rem;
        font-size: 0.95rem;
    }
}

/* Extra small phones */
@media (max-width: 375px) {
    .text-center.mb-5 h1.display-4 {
        font-size: 1.6rem;
    }

    .row.text-center.mb-5 .col-md-3 h2.fw-bold {
        font-size: 1.4rem;
    }

    .p-4.shadow-sm.rounded.h-100 {
        padding: 1rem !important;
    }

    .bg-dark.text-white.p-5.rounded h3.fw-bold {
        font-size: 1.1rem;
    }
}




</style>




<%- layout("/layouts/boilerplate") %>

<div class="container my-5">

  <!-- Header -->
  <div class="text-center mb-5">
    <h1 class="display-4 fw-bold">About Eventers</h1>
    <p class="lead text-muted">
      Turning your special moments into unforgettable experiences.
    </p>
  </div>

  <!-- Who We Are -->
  <div class="row align-items-center mb-5">
    <div class="col-md-6">
      <h3 class="fw-bold mb-3">Who We Are</h3>
      <p class="text-muted">
        Eventers is a smart event planning platform that connects users with
        trusted service providers for all types of events. From weddings and
        birthdays to corporate gatherings, we simplify the entire planning process.
      </p>
      <p class="text-muted">
        Our goal is to eliminate the stress of finding reliable vendors by offering
        a curated list of professionals, transparent pricing, and seamless booking.
      </p>
    </div>
    <div class="col-md-6">
      <img 
        src="https://images.unsplash.com/photo-1511795409834-ef04bbd61622" 
        class="img-fluid rounded shadow" 
        alt="Event Image">
    </div>
  </div>

  <!-- Mission & Vision -->
  <div class="row mb-5 text-center">
    <div class="col-md-6">
      <div class="p-4 shadow-sm rounded h-100">
        <h4 class="fw-bold">Our Mission</h4>
        <p class="text-muted">
          To make event planning simple, accessible, and stress-free by connecting
          users with the best service providers through technology.
        </p>
      </div>
    </div>
    <div class="col-md-6">
      <div class="p-4 shadow-sm rounded h-100">
        <h4 class="fw-bold">Our Vision</h4>
        <p class="text-muted">
          To become the most trusted event planning platform where every event,
          big or small, is executed flawlessly.
        </p>
      </div>
    </div>
  </div>

  <!-- What We Offer -->
  <div class="row text-center mb-5">
    <h3 class="fw-bold mb-4">What We Offer</h3>

    <div class="col-md-4">
      <div class="p-4 shadow-sm rounded h-100">
        <h5 class="fw-bold">Easy Booking</h5>
        <p class="text-muted">
          Browse services, compare options, and book instantly without hassle.
        </p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="p-4 shadow-sm rounded h-100">
        <h5 class="fw-bold">Verified Providers</h5>
        <p class="text-muted">
          Work with reliable and experienced professionals for your events.
        </p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="p-4 shadow-sm rounded h-100">
        <h5 class="fw-bold">All-in-One Platform</h5>
        <p class="text-muted">
          Manage everything from planning to execution in one place.
        </p>
      </div>
    </div>
  </div>

  <!-- How It Works -->
  <div class="mb-5">
    <h3 class="fw-bold text-center mb-4">How It Works</h3>
    <div class="row text-center">
      <div class="col-md-4">
        <h5 class="fw-bold">1. Explore</h5>
        <p class="text-muted">Browse services based on your event needs.</p>
      </div>
      <div class="col-md-4">
        <h5 class="fw-bold">2. Book</h5>
        <p class="text-muted">Choose the best provider and confirm instantly.</p>
      </div>
      <div class="col-md-4">
        <h5 class="fw-bold">3. Celebrate</h5>
        <p class="text-muted">Enjoy your event while we handle the rest.</p>
      </div>
    </div>
  </div>

  <!-- Stats -->
  <div class="row text-center mb-5">
    <div class="col-md-3">
      <h2 class="fw-bold">500+</h2>
      <p class="text-muted">Events Managed</p>
    </div>
    <div class="col-md-3">
      <h2 class="fw-bold">200+</h2>
      <p class="text-muted">Service Providers</p>
    </div>
    <div class="col-md-3">
      <h2 class="fw-bold">1000+</h2>
      <p class="text-muted">Happy Clients</p>
    </div>
    <div class="col-md-3">
      <h2 class="fw-bold">4.8★</h2>
      <p class="text-muted">Average Rating</p>
    </div>
  </div>

  <!-- Call to Action -->
  <div class="bg-dark text-white p-5 rounded text-center shadow">
    <h3 class="fw-bold mb-3">Start Planning Your Event Today</h3>
    <p class="mb-4">
      Discover the best service providers and make your event truly special.
    </p>
    <a href="/network" class="btn btn-light btn-lg">Explore Services</a>
  </div>

</div>