<%- layout("/layouts/boilerplate") %>

<div class="container my-5">

  <!-- Header -->
  <div class="text-center mb-5">
    <h1 class="display-4 fw-bold">About Eventers</h1>
    <p class="lead text-muted">
      Turning your special moments into unforgettable experiences.
    </p>
  </div>

  <!-- Who We Are -->
  <div class="row align-items-center mb-5">
    <div class="col-md-6">
      <h3 class="fw-bold mb-3">Who We Are</h3>
      <p class="text-muted">
        Eventers is a smart event planning platform that connects users with
        trusted service providers for all types of events. From weddings and
        birthdays to corporate gatherings, we simplify the entire planning process.
      </p>
      <p class="text-muted">
        Our goal is to eliminate the stress of finding reliable vendors by offering
        a curated list of professionals, transparent pricing, and seamless booking.
      </p>
    </div>
    <div class="col-md-6">
      <img 
        src="https://images.unsplash.com/photo-1511795409834-ef04bbd61622" 
        class="img-fluid rounded shadow" 
        alt="Event Image">
    </div>
  </div>

  <!-- Mission & Vision -->
  <div class="row mb-5 text-center">
    <div class="col-md-6">
      <div class="p-4 shadow-sm rounded h-100">
        <h4 class="fw-bold">Our Mission</h4>
        <p class="text-muted">
          To make event planning simple, accessible, and stress-free by connecting
          users with the best service providers through technology.
        </p>
      </div>
    </div>
    <div class="col-md-6">
      <div class="p-4 shadow-sm rounded h-100">
        <h4 class="fw-bold">Our Vision</h4>
        <p class="text-muted">
          To become the most trusted event planning platform where every event,
          big or small, is executed flawlessly.
        </p>
      </div>
    </div>
  </div>

  <!-- What We Offer -->
  <div class="row text-center mb-5">
    <h3 class="fw-bold mb-4">What We Offer</h3>

    <div class="col-md-4">
      <div class="p-4 shadow-sm rounded h-100">
        <h5 class="fw-bold">Easy Booking</h5>
        <p class="text-muted">
          Browse services, compare options, and book instantly without hassle.
        </p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="p-4 shadow-sm rounded h-100">
        <h5 class="fw-bold">Verified Providers</h5>
        <p class="text-muted">
          Work with reliable and experienced professionals for your events.
        </p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="p-4 shadow-sm rounded h-100">
        <h5 class="fw-bold">All-in-One Platform</h5>
        <p class="text-muted">
          Manage everything from planning to execution in one place.
        </p>
      </div>
    </div>
  </div>

  <!-- How It Works -->
  <div class="mb-5">
    <h3 class="fw-bold text-center mb-4">How It Works</h3>
    <div class="row text-center">
      <div class="col-md-4">
        <h5 class="fw-bold">1. Explore</h5>
        <p class="text-muted">Browse services based on your event needs.</p>
      </div>
      <div class="col-md-4">
        <h5 class="fw-bold">2. Book</h5>
        <p class="text-muted">Choose the best provider and confirm instantly.</p>
      </div>
      <div class="col-md-4">
        <h5 class="fw-bold">3. Celebrate</h5>
        <p class="text-muted">Enjoy your event while we handle the rest.</p>
      </div>
    </div>
  </div>

  <!-- Stats -->
  <div class="row text-center mb-5">
    <div class="col-md-3">
      <h2 class="fw-bold">500+</h2>
      <p class="text-muted">Events Managed</p>
    </div>
    <div class="col-md-3">
      <h2 class="fw-bold">200+</h2>
      <p class="text-muted">Service Providers</p>
    </div>
    <div class="col-md-3">
      <h2 class="fw-bold">1000+</h2>
      <p class="text-muted">Happy Clients</p>
    </div>
    <div class="col-md-3">
      <h2 class="fw-bold">4.8★</h2>
      <p class="text-muted">Average Rating</p>
    </div>
  </div>

  <!-- Call to Action -->
  <div class="bg-dark text-white p-5 rounded text-center shadow">
    <h3 class="fw-bold mb-3">Start Planning Your Event Today</h3>
    <p class="mb-4">
      Discover the best service providers and make your event truly special.
    </p>
    <a href="/network" class="btn btn-light btn-lg">Explore Services</a>
  </div>

</div>